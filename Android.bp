soong_namespace {
}

android_app_import {
    name: "Gramophone",
    owner: "thirdparty",
    apk: "proprietary/product/app/Gramophone/Gramophone.apk",
    preprocessed: true,
    presigned: true,
    overrides: [
        "Eleven",
        "Music",
    ],
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}

android_app_import {
    name: "RootExplorer",
    owner: "thirdparty",
    apk: "proprietary/product/app/RootExplorer/RootExplorer.apk",
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}

android_app_import {
    name: "Via",
    owner: "thirdparty",
    apk: "proprietary/product/app/Via/Via.apk",
    preprocessed: true,
    presigned: true,
    overrides: [
        "Browser2",
        "CarHTMLViewer",
        "Jelly",
    ],
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}

